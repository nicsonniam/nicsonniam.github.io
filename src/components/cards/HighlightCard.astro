---
const { alignment, title, description, description2, stack, link } = Astro.props;
---

<div
  class={`card p-5 md:p-6 ${
    alignment === 'left'
      ? 'text-left'
      : alignment === 'right'
      ? 'text-right'
      : 'text-center'
  }`}
>

  <h3 class="text-base md:text-lg font-semibold">
    {title}
  </h3>

  <p class="text-sm md:text-base text-gray-600 mt-2 leading-relaxed">
    {description}
  </p>

  {description2 && (
    <p class="text-sm md:text-base text-gray-600 mt-2 leading-relaxed">
      {description2}
    </p>
  )}

  <div class="mt-4 flex flex-wrap gap-2 justify-start md:justify-start">
    {stack.split('·').map((s: string) => (
      <span class="badge text-xs md:text-sm">
        {s.trim()}
      </span>
    ))}
  </div>

  {link && (
    <a
      target="_blank"
      href={link}
      class="text-blue-600 mt-4 inline-block text-sm md:text-base hover:underline"
    >
      View Project
    </a>
  )}

</div>